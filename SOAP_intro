        "# Compute pairwise cosine distances (1 - cosine similarity)\n",
        "# 0 = identical chemical environments, 1 = completely orthogonal environments\n",
        "dist_matrix = cdist(feature_matrix, feature_matrix, metric=\"cosine\")\n",
